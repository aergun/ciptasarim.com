# Environment
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is the committed
# template and must never hold a real secret.
#
# Nothing here is required for `npm run dev` to work. A development fallback is
# generated for the two secrets below, so a fresh clone runs with no setup —
# but it changes on every restart, which signs everyone out and invalidates
# every mock payment signature. Set them properly before deploying.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Signs the session cookie. Without it, sessions do not survive a restart and
# a forged cookie is easier to produce. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Signs mock payment notifications. Same generation command.
# Reached only when PAYMENT_PROVIDER=mock.
MOCK_PAYMENT_SECRET=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------

# 'mock' (the default) or, once implemented, a real gateway.
PAYMENT_PROVIDER=mock

# The mock provider refuses to create a checkout session when NODE_ENV is
# 'production' unless this is exactly 'true'. It is a deliberate override: a
# site that takes real money must never do so through the mock, and the
# cheapest way to guarantee that is to make production the wrong default.
#
# ⚠️ Set it only on a staging deployment you intend to test, and confirm it is
# `false` on the public domain before launch. The reference project left this
# live on its public site for weeks; the guard exists precisely to prevent that
# and it only works if the default stays false.
ALLOW_MOCK_PAYMENTS=false

# For a real gateway, once written. Never commit real keys.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Tax — ⚠️ NOT IMPLEMENTED, AND DELIBERATELY SO
# ---------------------------------------------------------------------------
#
# There is no tax handling in this codebase yet, and that is a decision rather
# than an omission.
#
# The reference project computed EU VAT for an EU-established business. That
# logic does not transfer. A Turkish business sells under KDV at a flat 20%,
# and Türkiye is in the EU customs union but is NOT an EU VAT member — so a
# domestic business customer gets no reverse charge, and the treatment of an
# exported licence differs again (B2B reverse charge, consumer destination
# rate, and Turkey-specific treatment of exported services).
#
# Place-of-supply rules for exported IP licences need an accountant, not a
# copied table. Until then the cart shows a price with no tax line and the
# terms must say so plainly. Do not add a VAT rate to this file to make the
# problem look smaller.

# ---------------------------------------------------------------------------
# Locale
# ---------------------------------------------------------------------------

# The default locale for a request that expresses no preference. The two trees
# are real URL prefixes ('/' is Turkish, '/en' is English); this only settles
# API responses and any future server-side rendering.
#
# 'tr' or 'en'. Anything unrecognised falls back to 'tr', the primary market.
DEFAULT_LOCALE=tr

# ---------------------------------------------------------------------------
# Paths and port
# ---------------------------------------------------------------------------

# SQLite file. Relative paths resolve from the project root.
DATABASE_PATH=data/app.db

# Where purchased licence deliveries are served from. Must NOT be inside
# `public/` — anything under `public/` is statically served, which would put
# every customer's paid RTL and gate-level netlist on the open web and make
# the download route's entitlement check decorative. The default lives outside
# the frontend build for that reason.
FILES_DIR=server/files

# The port the single Node process listens on. In development, Vite serves the
# frontend on 5173 and proxies /api here.
PORT=4000