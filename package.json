{
  "name": "ciptasarim",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n client,api -c cyan,magenta \"npm:dev:client\" \"npm:dev:api\"",
    "dev:client": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts --prod",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "smoke": "tsx server/smoke.ts",
    "verify:i18n": "tsx scripts/verify-i18n.ts",
    "verify:figures": "tsx scripts/verify-figures.ts",
    "verify:engineering": "tsx scripts/verify-engineering.ts",
    "verify:catalogue": "tsx scripts/verify-catalogue.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "nanoid": "^6.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}